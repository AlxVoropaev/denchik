# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend / API origins, JSON-encoded list
CORS_ORIGINS=["http://localhost:5173"]

# In production behind HTTPS, set this to true so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Where the frontend reaches the API. Localhost is for direct dev access; in compose
# the proxy at /api also works.
VITE_API_URL=http://localhost:8000
